# Playwright run artefacts. The BASELINES in e2e/visual.spec.ts-snapshots/ are
# committed on purpose — they are the reference the suite compares against —
# but per-run output never is: it holds actual/diff images, traces and failure
# screenshots regenerated on every run.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# The one account the run shares (Phase 21). Holds a live Django session cookie
# and the address it belongs to — a credential in everything but name, written
# fresh by e2e/auth.setup.ts on every run and never useful to anyone else.
/e2e/.auth/
