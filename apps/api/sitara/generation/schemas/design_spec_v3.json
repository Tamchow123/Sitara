    "SourceSelectionsV3": {
      "additionalProperties": false,
      "description": "Version-3 source selections: the questionnaire v4 contract.\n\nTwo deliberate replacements, both driven by questionnaire feedback:\n\n- colour is chosen per GARMENT ROLE (``fabric_colour`` / ``embroidery_colour``\n  / ``dupatta_colour``) plus the bride's own ``custom_colours`` palette,\n  instead of one unordered ``colour_palette``;\n- coverage is chosen per BODY AREA (``sleeves`` / ``back_coverage`` /\n  ``midriff`` / ``head_covering``) instead of one ``coverage_preferences``\n  multi-select.\n\nEvery replacement field is OPTIONAL in the questionnaire, so every one is\nnullable here — \"no preference\" is a first-class answer and must never be\nsilently turned into a default. Nothing is derived: this echoes exactly what\nthe questionnaire supplied. The version-independent projections the prompt\nbuilder, demo engine and demo selector need live in\n:mod:`sitara.generation.selection_semantics`.\n\nDeliberately NOT a subclass of :class:`SourceSelections`: version 3 does not\ncarry ``colour_palette`` or ``coverage_preferences`` at all, and\n``extra=\"forbid\"`` must reject them so a v1/v2 payload can never be\nmis-persisted as version 3.",
      "properties": {
        "back_coverage": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Back Coverage"
        },
        "ceremony": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Ceremony",
          "type": "string"
        },
        "custom_colours": {
          "items": {
            "pattern": "^#[0-9a-f]{6}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Custom Colours",
          "type": "array"
        },
        "dupatta_colour": {
          "anyOf": [
            {
              "pattern": "^(?:[a-z][a-z0-9_]{1,63}|#[0-9a-f]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dupatta Colour"
        },
        "dupatta_style": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dupatta Style"
        },
        "embellishment_density": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Embellishment Density"
        },
        "embellishment_styles": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Embellishment Styles",
          "type": "array"
        },
        "embroidery_colour": {
          "anyOf": [
            {
              "pattern": "^(?:[a-z][a-z0-9_]{1,63}|#[0-9a-f]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Embroidery Colour"
        },
        "fabric_colour": {
          "anyOf": [
            {
              "pattern": "^(?:[a-z][a-z0-9_]{1,63}|#[0-9a-f]{6})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fabric Colour"
        },
        "fabrics": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Fabrics",
          "type": "array"
        },
        "garment_type": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Garment Type",
          "type": "string"
        },
        "head_covering": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Head Covering"
        },
        "midriff": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Midriff"
        },
        "neckline_style": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Neckline Style"
        },
        "regional_style": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Regional Style"
        },
        "saree_drape": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Saree Drape"
        },
        "silhouette": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Silhouette",
          "type": "string"
        },
        "sleeves": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sleeves"
        }
      },
